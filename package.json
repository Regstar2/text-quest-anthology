{
  "name": "text-quest-anthology",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "compile:stories": "node scripts/compile-stories.cjs",
    "doctor": "react-native doctor",
    "lint": "eslint .",
    "preandroid": "npm run compile:stories",
    "prestart": "npm run compile:stories",
    "pretest": "npm run compile:stories",
    "pretypecheck": "npm run compile:stories",
    "start": "react-native start",
    "test": "jest",
    "test:release-metadata": "node scripts/verify-release-metadata.cjs",
    "test:story-packages": "node scripts/test-story-packages.cjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run compile:stories && npm run test:story-packages && npm run test:release-metadata && npm run typecheck && npm run lint && npm test -- --runInBand"
  },
  "dependencies": {
    "inkjs": "2.4.0",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-safe-area-context": "5.8.1",
    "yandex-mobile-ads": "8.3.0"
  },
  "devDependencies": {
    "@babel/core": "7.28.4",
    "@babel/preset-env": "7.28.3",
    "@babel/runtime": "7.28.4",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.2",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "prettier": "3.6.2",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
